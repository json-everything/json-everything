<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Json.Schema.Api.Analyzer</RootNamespace>
    <AssemblyName>JsonSchema.Net.Api.Analyzer</AssemblyName>

    <!-- Packed into JsonSchema.Net.Api; not shipped on its own. -->
    <IsPackable>false</IsPackable>

    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="PolySharp" Version="1.17.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JsonSchema.Generation\JsonSchema.Generation.csproj" ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
