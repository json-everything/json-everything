<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <NoWarn>IDE0290</NoWarn>
    <RootNamespace>Json.Schema.Generation.DataAnnotations</RootNamespace>
    <AssemblyName>JsonSchema.Net.Generation.DataAnnotations</AssemblyName>
    <DocumentationFile>JsonSchema.Net.Generation.DataAnnotations.xml</DocumentationFile>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>3.2.0</Version>
    <FileVersion>3.2.0</FileVersion>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <Description>Extends JsonSchema.Net.Generation to support the System.ComponentModel.DataAnnotations namespace</Description>
    <PackageTags>json-schema validation schema json generation schema-generation</PackageTags>
    <PackageReleaseNotes>Release notes can be found at https://docs.json-everything.net/rn-json-schema-generation-dataannotations/</PackageReleaseNotes>
  </PropertyGroup>

	<ItemGroup>
    <PackageReference Include="Humanizer.Core" Version="3.0.10" />
    <PackageReference Include="PolySharp" Version="1.17.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tools\ApiDocsGenerator\release-notes\rn-json-schema-generation-dataannotations.md" Link="release-notes.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JsonSchema.Generation\JsonSchema.Generation.csproj" />
  </ItemGroup>

</Project>
