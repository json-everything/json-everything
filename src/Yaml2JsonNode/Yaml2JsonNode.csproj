<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <NoWarn>CS1570</NoWarn>
    <DocumentationFile>Yaml2JsonNode.xml</DocumentationFile>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Yaml2JsonNode</PackageId>
    <Version>3.1.0</Version>
    <FileVersion>3.1.0</FileVersion>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <Description>Allows conversion of YamlDotNet's YAML models to JsonNodes</Description>
    <PackageTags>json yaml system.text.json yamldotnet yaml.net</PackageTags>
    <PackageReleaseNotes>Release notes can be found at https://docs.json-everything.net/rn-yaml/</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.17.1" PrivateAssets="all" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tools\ApiDocsGenerator\release-notes\rn-yaml.md" Link="release-notes.md" />
  </ItemGroup>

</Project>
