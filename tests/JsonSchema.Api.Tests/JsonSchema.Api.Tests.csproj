<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<RootNamespace>Json.Schema.Api.Tests</RootNamespace>
		<NoWarn>IDE0290;CS1591</NoWarn>
		<GenerateProgramFile>false</GenerateProgramFile>
		<!-- The generator reads documentation comments into the description, which needs them parsed. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup>
		<!--
			The test host's models are generated at compile time, so their property naming
			comes from here rather than from the runtime converter configuration.
		-->
		<JsonSchemaDefaultPropertyNaming>CamelCase</JsonSchemaDefaultPropertyNaming>
	</PropertyGroup>

	<ItemGroup>
		<CompilerVisibleProperty Include="JsonSchemaDefaultPropertyNaming" />
		<CompilerVisibleProperty Include="JsonSchemaDefaultEnumFormat" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\JsonSchema.Api\JsonSchema.Api.csproj" />
		<ProjectReference Include="..\TestHelpers\TestHelpers.csproj" />
		<ProjectReference Include="..\..\src\JsonSchema.Api.Analyzer\JsonSchema.Api.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<!--
			In a package, the analyzer's dependencies ship next to it in analyzers/dotnet/cs.
			Referencing by project means supplying them here so the compiler can load them.
		-->
		<Analyzer Include="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\JsonSchema.Generation\bin\$(Configuration)\net10.0\JsonSchema.Net.Generation.dll'))" />
		<Analyzer Include="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\JsonSchema\bin\$(Configuration)\netstandard2.0\JsonSchema.Net.dll'))" />
		<Analyzer Include="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\JsonPointer\bin\$(Configuration)\netstandard2.0\JsonPointer.Net.dll'))" />
		<Analyzer Include="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\Json.More\bin\$(Configuration)\netstandard2.0\Json.More.dll'))" />
	</ItemGroup>

</Project>
